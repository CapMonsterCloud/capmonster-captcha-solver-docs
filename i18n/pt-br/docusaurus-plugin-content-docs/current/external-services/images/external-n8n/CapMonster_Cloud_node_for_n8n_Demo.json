        "jsCode": "const html = $input.first().json.data;\nconst match = html.match(/<pre>([\\s\\S]*?)<\\/pre>/);\nif (!match) {\n  return [{ json: { success: false, challenge_ts: null, hostname: null, _error: 'No pre tag found' } }];\n}\nconst parsed = JSON.parse(match[1].trim());\nreturn [{ json: parsed }];"
